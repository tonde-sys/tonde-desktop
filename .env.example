# ============================================================
# TONDE Desktop — Variables d'environnement (exemple)
# Copier vers .env.local pour surcharger en développement.
# Ne jamais committer de secret dans ce fichier.
# ============================================================

# development | staging | production
VITE_ENV=development

# Backend FastAPI.
# development → localhost ; staging/production → Render (valeur par défaut
# dans src/config/api.ts, inutile de la redéfinir).
# VITE_API_URL=https://tonde-api-bdi.onrender.com

# WebSocket : dérivé de VITE_API_URL (http→ws) s'il n'est pas fourni.
# VITE_WS_URL=ws://localhost:8000
# VITE_WS_URL=wss://tonde-api-bdi.onrender.com

# Préfixe REST (contrat TONDE). Laisser vide si le backend sert la racine.
VITE_API_PREFIX=/api/v1

# Contexte du poste (multi-tenant). Non fourni par le JWT agent :
# si absent, une seule saisie est demandée sur l'écran de sélection du guichet,
# puis mémorisée dans le stockage local du poste.
# VITE_TONDE_ORG_ID=00000000-0000-0000-0000-000000000000
# VITE_TONDE_BRANCH_ID=00000000-0000-0000-0000-000000000000

# API mock locale — ignorée hors mode DEV
VITE_USE_MOCK=false
