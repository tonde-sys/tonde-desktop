# ============================================================
# TONDE Desktop — Variables d'environnement (exemple)
# Copier vers .env.local pour surcharger en développement.
# Ne jamais committer de secret dans ce fichier.
# ============================================================

# development | staging | production
VITE_ENV=development

# Backend FastAPI
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Préfixe REST (contrat TONDE). Laisser vide si le backend sert la racine.
VITE_API_PREFIX=/api/v1

# API mock locale — ignorée hors mode DEV
VITE_USE_MOCK=false
