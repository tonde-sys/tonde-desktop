{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TONDE Desktop",
  "version": "0.2.1",
  "identifier": "app.tonde.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TONDE — Guichetier",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "TONDE",
    "copyright": "© TONDE",
    "category": "Business",
    "shortDescription": "Poste guichetier TONDE",
    "longDescription": "Application de guichet TONDE : appel des tickets, gestion de la file et mode hors-ligne.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "languages": ["French"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/tonde-sys/tonde-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1NEQ1Qjc3MjQxNjk2MEUKUldRT2xoWWtkMXROeGYvbW0weU5HaUI3bzVSWkhnTHR0dnl3NGVha0J1TnJQTnZHNWhOZ2tieGQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
